// Prisma schema. Models will be added later.
// After `npm install` and `docker compose up -d`, run:
//   npx prisma generate
//   npx prisma migrate dev --name init   (once the first model is added)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String @map("password_hash")

  status UserStatus @default(PENDING)

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  player        Player?
  userRoles     UserRole[]
  notifications Notification[]

  @@map("user")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Player {
  id String @id @default(uuid())

  firstName String @map("first_name")
  lastName  String @map("last_name")

  dateOfBirth DateTime @map("date_of_birth") @db.Date

  gender Gender

  email String?
  phone String?

  // Dashboard profile photograph. Null means the frontend renders initials.
  avatarUrl String? @map("avatar_url")

  isJunior Boolean @default(false) @map("is_junior")

  status PlayerStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId          String?          @unique @map("user_id")
  user            User?            @relation(fields: [userId], references: [id])
  clubMemberships ClubMembership[]
  mergeIntoId     String?          @map("merge_into_id")
  mergeInto       Player?          @relation("PlayerMerge", fields: [mergeIntoId], references: [id])
  mergedFrom      Player[]         @relation("PlayerMerge")

  utrLink                UtrLink?
  associationMemberships AssociationMembership[]
  teamPlayers            TeamPlayer[]
  rubberPlayers          RubberPlayer[]
  utrSnapshots           UtrRatingSnapshot[]
  rankingEntries         RankingEntry[]
  awards                 PlayerAward[]
  standings              PlayerStanding[]

  @@index([lastName, firstName, dateOfBirth])
  @@map("player")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Association {
  id String @id @default(uuid())

  name    String
  email   String?
  address String?
  phone   String?

  status AssociationStatus @default(ACTIVE)

  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  associationMemberships AssociationMembership[]
  competitions           Competition[]
  clubs                  Club[]
  rankingCohorts         RankingCohort[]

  @@map("association")
}

enum AssociationStatus {
  ACTIVE
  INACTIVE
}

model Club {
  id String @id @default(uuid())

  associationId String      @map("association_id")
  association   Association @relation(fields: [associationId], references: [id])

  name    String
  address String?
  email   String?
  phone   String?

  status ClubStatus @default(ACTIVE)

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  teams           Team[]
  clubMemberships ClubMembership[]
  venues          Venue[]

  @@map("club")
}

enum ClubStatus {
  ACTIVE
  INACTIVE
}

model ClubMembership {
  id String @id @default(uuid())

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id])

  isPrimary Boolean @default(false) @map("is_primary")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([playerId, clubId])
  @@map("club_membership")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

// UserRole — role-based access control
model UserRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  roleType    RoleType    @map("role_type")
  contextType ContextType @map("context_type")

  associationId String? @map("association_id")
  clubId        String? @map("club_id")
  teamId        String? @map("team_id")
  competitionId String? @map("competition_id")

  grantedAt DateTime? @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_role")
}

enum RoleType {
  ADMINISTRATOR
  RECORDS_SECRETARY
  CLUB_ADMIN
  TEAM_MANAGER
  PLAYER
  PUBLIC
}

enum ContextType {
  ASSOCIATION
  CLUB
  TEAM
  COMPETITION
  GLOBAL
}

// UtrLink — player's UTR rating (not calculated here)
model UtrLink {
  id String @id @default(uuid())

  playerId String @unique @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  utrAccountId String?   @map("utr_account_id")
  utrRating    Decimal?  @map("utr_rating") @db.Decimal(5, 2)
  lastSyncedAt DateTime? @map("last_synced_at")

  status LinkStatus @default(ACTIVE)

  @@map("utr_link")
}

enum LinkStatus {
  ACTIVE
  INACTIVE
}

// AssociationMembership — player across associations
model AssociationMembership {
  id String @id @default(uuid())

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  associationId String      @map("association_id")
  association   Association @relation(fields: [associationId], references: [id])

  isPrimary Boolean          @default(false) @map("is_primary")
  status    MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([playerId, associationId])
  @@map("association_membership")
}

// ProfileMergeRequest — merge duplicate player records
model ProfileMergeRequest {
  id String @id @default(uuid())

  status MergeStatus @default(PENDING)

  playerAId String @map("player_a_id")
  playerBId String @map("player_b_id")

  requestingAssociationId String?   @map("requesting_association_id")
  note                    String?
  resolvedAt              DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("profile_merge_request")
}

enum MergeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Competition
model Competition {
  id String @id @default(uuid())

  associationId String      @map("association_id")
  association   Association @relation(fields: [associationId], references: [id])

  name   String
  type   String?
  status CompetitionStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seasons          Season[]
  matchFormats     MatchFormat[]
  eligibilityRules EligibilityRule[]
  awards           PlayerAward[]

  @@map("competition")
}

enum CompetitionStatus {
  ACTIVE
  ARCHIVED
}

// MatchFormat — configurable format (rubbers, sets, tiebreaks)
model MatchFormat {
  id String @id @default(uuid())

  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])

  name               String
  rubberCount        Int?    @map("rubber_count")
  setFormat          String? @map("set_format")
  setToWin           Int?    @map("set_to_win")
  tiebreakRule       String? @map("tiebreak_rule")
  matchTiebreak      String? @map("match_tiebreak")
  winnerDeterminedBy String? @map("winner_determined_by")
  allowDraw          Boolean @default(false) @map("allow_draw")
  singlesCount       Int?    @map("singles_count")
  doublesCount       Int?    @map("doubles_count")

  createdAt DateTime @default(now()) @map("created_at")

  rubbers Rubber[]

  @@map("match_format")
}

// Season
model Season {
  id String @id @default(uuid())

  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])

  year       Int?
  seasonType String?   @map("season_type")
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date

  status SeasonStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections SectionGrade[]
  awards   PlayerAward[]

  @@map("season")
}

enum SeasonStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// SectionGrade — division / grade
model SectionGrade {
  id String @id @default(uuid())

  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id])

  name      String
  gender    Gender?
  ageGroup  String? @map("age_group")
  minAge    Int?    @map("min_age")
  maxAge    Int?    @map("max_age")
  teamCount Int?    @map("team_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams           Team[]
  fixtures        Fixture[]
  ladderEntries   LadderEntry[]
  playerStandings PlayerStanding[]

  @@map("section_grade")
}

// Team
model Team {
  id String @id @default(uuid())

  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id])

  sectionId String       @map("section_id")
  section   SectionGrade @relation(fields: [sectionId], references: [id])

  contactUserId String? @map("contact_user_id")

  // Where this team's home fixtures are played. A club can own several venues,
  // so the draw generator needs the team's own choice, not just club.venues.
  homeVenueId String? @map("home_venue_id")
  homeVenue   Venue?  @relation("TeamHomeVenue", fields: [homeVenueId], references: [id])

  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teamPlayers   TeamPlayer[]
  homeFixtures  Fixture[]     @relation("HomeTeam")
  awayFixtures  Fixture[]     @relation("AwayTeam")
  ladderEntries LadderEntry[]
  awards        PlayerAward[]

  @@map("team")
}

// TeamPlayer — team roster
model TeamPlayer {
  id String @id @default(uuid())

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id])

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  status     TeamPlayerStatus @default(ACTIVE)
  registerAt DateTime?        @map("register_at")

  @@unique([teamId, playerId])
  @@map("team_player")
}

enum TeamPlayerStatus {
  ACTIVE
  EMERGENCY
  INACTIVE
}

// Fixture — scheduled match between two teams
model Fixture {
  id String @id @default(uuid())

  sectionId String       @map("section_id")
  section   SectionGrade @relation(fields: [sectionId], references: [id])

  homeTeamId String @map("home_team_id")
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId String @map("away_team_id")
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  // Null until the venue is allocated; the API then returns venue: null.
  venueId String? @map("venue_id")
  venue   Venue?  @relation(fields: [venueId], references: [id])

  roundNumber Int? @map("round_number")

  // Display label for finals rounds ("Semi Final", "Round of 32"). Round 5 must
  // not be rendered as "Round of 32"; only use this when it is set.
  roundLabel String? @map("round_label")

  scheduleDate DateTime?     @map("schedule_date") @db.Date
  scheduleTime DateTime?     @map("schedule_time") @db.Time
  status       FixtureStatus @default(SCHEDULED)
  isFinals     Boolean       @default(false) @map("is_finals")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  matchResult     MatchResult?
  scheduleChanges FixtureScheduleChange[]

  @@index([venueId, scheduleDate])
  @@map("fixture")
}

enum FixtureStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  // Called off with no replacement date agreed yet.
  POSTPONED
}

// MatchResult — result with status and approval flow
model MatchResult {
  id String @id @default(uuid())

  fixtureId String  @unique @map("fixture_id")
  fixture   Fixture @relation(fields: [fixtureId], references: [id])

  homeRubbers Int?         @map("home_rubbers")
  awayRubbers Int?         @map("away_rubbers")
  status      ResultStatus @default(DRAFT)
  outcome     String?
  notes       String?

  enteredBy   String?   @map("entered_by")
  finalisedBy String?   @map("finalised_by")
  enteredAt   DateTime? @map("entered_at")
  finalisedAt DateTime? @map("finalised_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  rubbers       Rubber[]
  confirmations ResultConfirmation[]
  corrections   CorrectionRequest[]

  @@map("match_result")
}

enum ResultStatus {
  DRAFT
  PENDING_CONFIRMATION
  FINALISED
  UNDER_CORRECTION
}

// Rubber — a singles/doubles match within a fixture
model Rubber {
  id String @id @default(uuid())

  matchResultId String      @map("match_result_id")
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id])

  matchFormatId String?      @map("match_format_id")
  matchFormat   MatchFormat? @relation(fields: [matchFormatId], references: [id])

  rubberNumber     Int?       @map("rubber_number")
  rubberType       RubberType @map("rubber_type")
  incompleteReason String?    @map("incomplete_reason")

  // Recorded explicitly, never inferred from set scores: a retirement or
  // walkover can be won by the side with fewer games. Null = not yet decided.
  winnerSide  Side?          @map("winner_side")
  outcomeType RubberOutcome? @map("outcome_type")

  // When the rubber was actually played, which can differ from the fixture's
  // scheduled date. Results sort on this before falling back to the schedule.
  playedAt DateTime? @map("played_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rubberSets    RubberSet[]
  rubberPlayers RubberPlayer[]

  @@map("rubber")
}

enum RubberType {
  SINGLES
  DOUBLES
}

// How a rubber ended. FORFEIT and WALKOVER are excluded from UTR export.
enum RubberOutcome {
  COMPLETED
  RETIRED
  WALKOVER
  FORFEIT
  ABANDONED
}

// RubberSet — set score within a rubber
model RubberSet {
  id String @id @default(uuid())

  rubberId String @map("rubber_id")
  rubber   Rubber @relation(fields: [rubberId], references: [id])

  setNumber  Int?    @map("set_number")
  homeGames  Int?    @map("home_games")
  awayGames  Int?    @map("away_games")
  isTiebreak Boolean @default(false) @map("is_tiebreak")

  // Tiebreak points, e.g. 7-5 inside a 7-6 set. Null when not played.
  homeTiebreakPoints Int? @map("home_tiebreak_points")
  awayTiebreakPoints Int? @map("away_tiebreak_points")

  @@map("rubber_set")
}

// RubberPlayer — players in a rubber
model RubberPlayer {
  id String @id @default(uuid())

  rubberId String @map("rubber_id")
  rubber   Rubber @relation(fields: [rubberId], references: [id])

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  isEmergency Boolean @default(false) @map("is_emergency")
  side        Side
  playerOrder Int?    @map("player_order")

  @@map("rubber_player")
}

enum Side {
  HOME
  AWAY
}

// ResultConfirmation — opponent confirms result
model ResultConfirmation {
  id String @id @default(uuid())

  matchResultId String      @map("match_result_id")
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id])

  status          ConfirmationStatus @default(PENDING)
  homeEnteredBy   String?            @map("home_entered_by")
  awayConfirmedBy String?            @map("away_confirmed_by")
  homeEnteredAt   DateTime?          @map("home_entered_at")
  awayConfirmedAt DateTime?          @map("away_confirmed_at")
  scoreCorrect    Boolean?           @map("score_correct")
  commentsCorrect Boolean?           @map("comments_correct")
  disputeReason   String?            @map("dispute_reason")

  @@map("result_confirmation")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

// CorrectionRequest — request to correct a result
model CorrectionRequest {
  id String @id @default(uuid())

  matchResultId String      @map("match_result_id")
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id])

  requestedAt   DateTime?        @map("requested_at")
  requestedBy   String?          @map("requested_by")
  reason        String?
  status        CorrectionStatus @default(PENDING)
  reviewBy      String?          @map("review_by")
  reviewAt      DateTime?        @map("review_at")
  reviewedNotes String?          @map("reviewed_notes")

  @@map("correction_request")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// EligibilityRule — configurable eligibility rules
model EligibilityRule {
  id String @id @default(uuid())

  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])

  ruleType         String  @map("rule_type")
  scope            String?
  minMatchesPlayed Int?    @map("min_matches_played")
  gradeRestriction String? @map("grade_restriction")
  description      String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("eligibility_rule")
}

// AuditLog — log of important admin changes
model AuditLog {
  id String @id @default(uuid())

  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  action        String
  changedAt     DateTime @default(now()) @map("changed_at")
  changeSummary String?  @map("change_summary")
  changedBy     String?  @map("changed_by")

  @@map("audit_log")
}

// Venue — where a fixture is actually played. A club's own address is not
// assumed to be the venue: finals and hired courts are often neutral ground.
model Venue {
  id String @id @default(uuid())

  name    String
  address String?

  // IANA zone, e.g. "Australia/Melbourne". Fixture times are local to here;
  // fall back to the documented application default when a fixture has no venue.
  timeZone String @map("time_zone")

  // How many fixtures the draw generator may schedule here at the same time.
  courtCount Int? @map("court_count")

  // Set when the venue belongs to a club; null for neutral/hired courts.
  clubId String? @map("club_id")
  club   Club?   @relation(fields: [clubId], references: [id])

  status VenueStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fixtures        Fixture[]
  homeTeams       Team[]                  @relation("TeamHomeVenue")
  changedFromHere FixtureScheduleChange[] @relation("PreviousVenue")
  changedToHere   FixtureScheduleChange[] @relation("NewVenue")

  @@index([clubId])
  @@map("venue")
}

enum VenueStatus {
  ACTIVE
  INACTIVE
}

// FixtureScheduleChange — one row per reschedule or venue move. The dashboard's
// "rescheduled" badge is derived from the existence of a row, so there is no
// denormalised flag on Fixture that could drift out of sync.
model FixtureScheduleChange {
  id String @id @default(uuid())

  fixtureId String  @map("fixture_id")
  fixture   Fixture @relation(fields: [fixtureId], references: [id])

  changeType ScheduleChangeType @map("change_type")

  previousDate DateTime? @map("previous_date") @db.Date
  previousTime DateTime? @map("previous_time") @db.Time
  newDate      DateTime? @map("new_date") @db.Date
  newTime      DateTime? @map("new_time") @db.Time

  previousVenueId String? @map("previous_venue_id")
  previousVenue   Venue?  @relation("PreviousVenue", fields: [previousVenueId], references: [id])
  newVenueId      String? @map("new_venue_id")
  newVenue        Venue?  @relation("NewVenue", fields: [newVenueId], references: [id])

  reason String?

  changedBy String?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([fixtureId, changedAt])
  @@map("fixture_schedule_change")
}

enum ScheduleChangeType {
  DATE_TIME_CHANGED
  VENUE_CHANGED
  POSTPONED
  CANCELLED
}

// Notification — one row per recipient per channel. The same event creates an
// IN_APP row and, where the recipient wants email, a separate EMAIL row; unread
// counts only ever count IN_APP rows.
model Notification {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  title   String
  message String

  // Type-specific payload, e.g. previousDate/newDate/timeZone for a
  // DATE_TIME change. Shape per type is documented in dashboardapi.md.
  details Json?

  // What the card links to. Null means the notification is informational.
  targetType NotificationTargetType? @map("target_type")
  targetId   String?                 @map("target_id")

  channel        NotificationChannel        @default(IN_APP)
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  sentAt         DateTime?                  @map("sent_at")
  failureReason  String?                    @map("failure_reason")

  // Null means unread. In-app only; EMAIL rows leave this null.
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, channel, readAt])
  @@map("notification")
}

enum NotificationType {
  MATCH_DATE_CHANGED
  VENUE_CHANGED
  DRAW_RELEASED
  MATCH_REMINDER
  RESULT_ENTERED
  RESULT_DISPUTED
  EMERGENCY_PLAYER_REQUIRED
  COMPETITION_UPDATE
}

enum NotificationTargetType {
  FIXTURE
  RUBBER
  MATCH_RESULT
  COMPETITION
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Singles and doubles ratings are separate populations and must not be mixed.
enum Discipline {
  SINGLES
  DOUBLES
}

// UtrRatingSnapshot — dated rating points supplied by Universal Tennis. The
// platform stores them, it does not calculate them. UtrLink stays the account
// link; its single utrRating remains the legacy undifferentiated value.
model UtrRatingSnapshot {
  id String @id @default(uuid())

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  // Null only for legacy rows imported before singles/doubles were separated.
  discipline Discipline?

  rating     Decimal  @db.Decimal(5, 2)
  recordedAt DateTime @map("recorded_at")

  // Where the value came from, e.g. "UTR_API" or "MANUAL_IMPORT".
  source String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([playerId, discipline, recordedAt])
  @@index([playerId, discipline, recordedAt])
  @@map("utr_rating_snapshot")
}

// RankingCohort — the comparison population a percentile is measured against.
// "Top 12%" is meaningless without naming the group it is 12% of.
model RankingCohort {
  id String @id @default(uuid())

  name        String
  description String?

  // Null for a platform-wide cohort.
  associationId String?      @map("association_id")
  association   Association? @relation(fields: [associationId], references: [id])

  discipline Discipline?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries RankingEntry[]

  @@map("ranking_cohort")
}

// RankingEntry — one player's dated position within one cohort.
model RankingEntry {
  id String @id @default(uuid())

  cohortId String        @map("cohort_id")
  cohort   RankingCohort @relation(fields: [cohortId], references: [id])

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  rank   Int
  rating Decimal? @db.Decimal(5, 2)

  // 0-100 within this cohort. Never derived by dividing a rating by 10.
  percentileRank Decimal? @map("percentile_rank") @db.Decimal(5, 2)

  asOf DateTime @map("as_of")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cohortId, playerId, asOf])
  @@index([cohortId, asOf, rank])
  @@index([playerId, asOf])
  @@map("ranking_entry")
}

// PlayerAward — backs the "Title" counter. Which award types count as a title
// is a product decision; store them all and filter when counting.
model PlayerAward {
  id String @id @default(uuid())

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  awardType AwardType @map("award_type")
  title     String

  competitionId String?      @map("competition_id")
  competition   Competition? @relation(fields: [competitionId], references: [id])

  seasonId String? @map("season_id")
  season   Season? @relation(fields: [seasonId], references: [id])

  // Set when the award was won with a team rather than individually.
  teamId String? @map("team_id")
  team   Team?   @relation(fields: [teamId], references: [id])

  awardedOn DateTime? @map("awarded_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@index([playerId, awardedOn])
  @@map("player_award")
}

enum AwardType {
  COMPETITION_WINNER
  SECTION_WINNER
  RUNNER_UP
  OTHER
}

// LadderEntry — cached team ladder for one section. Recalculated whenever a
// result is finalised or corrected; MatchResult remains the source of truth.
model LadderEntry {
  id String @id @default(uuid())

  sectionId String       @map("section_id")
  section   SectionGrade @relation(fields: [sectionId], references: [id])

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id])

  // Null while the ladder is being rebuilt. Ties share a position.
  position Int?

  played Int @default(0)
  won    Int @default(0)
  lost   Int @default(0)
  drawn  Int @default(0)

  rubbersFor     Int @default(0) @map("rubbers_for")
  rubbersAgainst Int @default(0) @map("rubbers_against")
  setsFor        Int @default(0) @map("sets_for")
  setsAgainst    Int @default(0) @map("sets_against")
  gamesFor       Int @default(0) @map("games_for")
  gamesAgainst   Int @default(0) @map("games_against")

  points Int @default(0)

  calculatedAt DateTime @map("calculated_at")

  @@unique([sectionId, teamId])
  @@index([sectionId, position])
  @@map("ladder_entry")
}

// PlayerStanding — cached individual standings for one section, counted from
// finalised rubbers only. A team fixture win is not one win per team member.
model PlayerStanding {
  id String @id @default(uuid())

  sectionId String       @map("section_id")
  section   SectionGrade @relation(fields: [sectionId], references: [id])

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id])

  position Int?

  rubbersPlayed Int @default(0) @map("rubbers_played")
  rubbersWon    Int @default(0) @map("rubbers_won")
  rubbersLost   Int @default(0) @map("rubbers_lost")
  setsWon       Int @default(0) @map("sets_won")
  setsLost      Int @default(0) @map("sets_lost")
  gamesWon      Int @default(0) @map("games_won")
  gamesLost     Int @default(0) @map("games_lost")

  // Null when nothing has been played, or when an outcome is still unresolved.
  winPercentage Decimal? @map("win_percentage") @db.Decimal(5, 2)

  calculatedAt DateTime @map("calculated_at")

  @@unique([sectionId, playerId])
  @@index([sectionId, position])
  @@map("player_standing")
}
