{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "nest build && node --test test/*.test.cjs",
    "test:coverage": "nest build && node --enable-source-maps --test --experimental-test-coverage --test-coverage-exclude=\"prisma/**\" --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.cjs",
    "test:database": "nest build && node --env-file-if-exists=.env --test test/seed-competition.integration.cjs test/player-matching.integration.cjs test/junior-privacy.integration.cjs",
    "prisma:generate": "prisma generate --allow-no-models",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:competition": "tsx prisma/seed-competition.ts",
    "data:generate": "node prisma/generate-competition-data.js",
    "players:duplicates": "tsx prisma/find-duplicate-players.ts",
    "data:check": "node prisma/check-data-integrity.js && node prisma/check-competition-data.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed-competition.ts"
  }
}
