# Copy to backend/.env for local dev (Docker Compose defaults below)
DATABASE_URL="postgresql://tenniscomp:tenniscomp@localhost:5432/tenniscomp?schema=public"

# API server port, and the browser origin(s) allowed to call it (comma-separated).
PORT=3000
CORS_ORIGIN=http://localhost:5173

# UTR: disabled (default), mock (development only), or engage.
UTR_PROVIDER=disabled
UTR_API_BASE_URL=https://prod-utr-engage-api-data-azapp.azurewebsites.net/api/v1
# Reserved for the client's OAuth connection implementation; not used by the reader.
UTR_CLIENT_ID=
UTR_CLIENT_SECRET=
UTR_REDIRECT_URI=
